{
  // Arduino Extension Tasks for Unix/Linux/Mac
  // Copy this file to your workspace:  .zed/tasks.json
  //
  // Before using:
  // 1. Configure your board in .zed/settings.json (see SETTINGS.md)
  // 2. Update the "fqbn" (board type) and "port" settings
  //
  // For more information: https://github.com/SB-CMR-Talana/zed-arduino

  "tasks": [
    // === Essential Workflow ===

    {
      "label": "Arduino: Compile, Upload & Monitor",
      "command": "FQBN=$(grep '\"fqbn\"' .zed/settings.json 2>/dev/null | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$FQBN\" ]; then echo 'Error: FQBN not found in .zed/settings.json'; exit 1; fi; PORT=$(grep '\"port\"' .zed/settings.json | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$PORT\" ]; then PORT=$(arduino-cli board list --format json 2>/dev/null | grep -o '\"address\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4); fi; if [ -z \"$PORT\" ]; then echo 'Error: Port not configured'; exit 1; fi; BAUD=$(grep '\"baudRate\"' .zed/settings.json | grep -o '[0-9]\\+' | head -1); if [ -z \"$BAUD\" ]; then BAUD=9600; fi; arduino-cli compile -b \"$FQBN\" . 2>&1 | tee .zed/last_compile.log && arduino-cli upload -p \"$PORT\" -b \"$FQBN\" . && arduino-cli monitor -p \"$PORT\" --config \"$BAUD\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Compile & Upload",
      "command": "FQBN=$(grep '\"fqbn\"' .zed/settings.json 2>/dev/null | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$FQBN\" ]; then echo 'Error: FQBN not found'; exit 1; fi; PORT=$(grep '\"port\"' .zed/settings.json | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$PORT\" ]; then PORT=$(arduino-cli board list --format json 2>/dev/null | grep -o '\"address\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4); fi; if [ -z \"$PORT\" ]; then echo 'Error: Port not configured'; exit 1; fi; arduino-cli compile -b \"$FQBN\" . 2>&1 | tee .zed/last_compile.log && arduino-cli upload -p \"$PORT\" -b \"$FQBN\" .",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Compile",
      "command": "FQBN=$(grep '\"fqbn\"' .zed/settings.json 2>/dev/null | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$FQBN\" ]; then echo 'Error: FQBN not found'; exit 1; fi; mkdir -p .zed; arduino-cli compile -b \"$FQBN\" . 2>&1 | tee .zed/last_compile.log",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Upload (last compile)",
      "command": "FQBN=$(grep '\"fqbn\"' .zed/settings.json 2>/dev/null | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$FQBN\" ]; then echo 'Error: FQBN not found'; exit 1; fi; PORT=$(grep '\"port\"' .zed/settings.json | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$PORT\" ]; then PORT=$(arduino-cli board list --format json 2>/dev/null | grep -o '\"address\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4); fi; if [ -z \"$PORT\" ]; then echo 'Error: Port not configured'; exit 1; fi; arduino-cli upload -p \"$PORT\" -b \"$FQBN\" .",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Monitor Serial",
      "command": "PORT=$(grep '\"port\"' .zed/settings.json | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$PORT\" ]; then PORT=$(arduino-cli board list --format json 2>/dev/null | grep -o '\"address\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4); fi; if [ -z \"$PORT\" ]; then echo 'Error: Port not configured'; exit 1; fi; BAUD=$(grep '\"baudRate\"' .zed/settings.json | grep -o '[0-9]\\+' | head -1); if [ -z \"$BAUD\" ]; then BAUD=9600; fi; arduino-cli monitor -p \"$PORT\" --config \"$BAUD\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: List Boards & Ports",
      "command": "arduino-cli board list",
      "use_new_terminal": true
    },

    // === Board & Hardware ===

    {
      "label": "Arduino: Search Boards",
      "command": "echo 'Enter search term:' && read SEARCH && arduino-cli board listall | grep -i \"$SEARCH\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Board Details",
      "command": "FQBN=$(grep '\"fqbn\"' .zed/settings.json 2>/dev/null | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$FQBN\" ]; then echo 'Error: FQBN not found'; exit 1; fi; arduino-cli board details -b \"$FQBN\"",
      "use_new_terminal": true
    },

    // === Core Management ===

    {
      "label": "Arduino: Update Core Index",
      "command": "arduino-cli core update-index",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: List Installed Cores",
      "command": "arduino-cli core list",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Install Core",
      "command": "arduino-cli core list && echo '' && echo 'Enter core to install (e.g., arduino:avr):' && read CORE && arduino-cli core install \"$CORE\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Uninstall Core",
      "command": "arduino-cli core list && echo '' && echo 'Enter core to uninstall:' && read CORE && arduino-cli core uninstall \"$CORE\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Upgrade All Cores",
      "command": "arduino-cli core upgrade",
      "use_new_terminal": true
    },

    // === Library Management ===

    {
      "label": "Arduino: Search Libraries",
      "command": "echo 'Enter search term:' && read SEARCH && arduino-cli lib search \"$SEARCH\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: List Installed Libraries",
      "command": "arduino-cli lib list",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Install Library",
      "command": "echo 'Enter library name:' && read LIBRARY && arduino-cli lib install \"$LIBRARY\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Uninstall Library",
      "command": "echo 'Enter library name:' && read LIBRARY && arduino-cli lib uninstall \"$LIBRARY\"",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Upgrade All Libraries",
      "command": "arduino-cli lib upgrade",
      "use_new_terminal": true
    },

    // === Project Management ===

    {
      "label": "Arduino: Generate Compilation Database",
      "command": "FQBN=$(grep '\"fqbn\"' .zed/settings.json 2>/dev/null | grep -o '\"[^\"]*\"' | tail -1 | tr -d '\"'); if [ -z \"$FQBN\" ]; then echo 'Error: FQBN not found'; exit 1; fi; arduino-cli compile --fqbn \"$FQBN\" --only-compilation-database .",
      "use_new_terminal": true
    },
    {
      "label": "Arduino: Create Settings Template",
      "command": "mkdir -p .zed && cat > .zed/settings.json << 'EOF'\n{\n  \"lsp\": {\n    \"arduino\": {\n      \"settings\": {\n        \"fqbn\": \"arduino:avr:uno\",\n        \"port\": \"/dev/ttyUSB0\",\n        \"baudRate\": 9600\n      }\n    }\n  }\n}\nEOF\necho 'Created .zed/settings.json - Edit the FQBN and port' && cat .zed/settings.json",
      "use_new_terminal": true
    }

    // === Optional: Advanced/Diagnostic Tasks ===
    // Uncomment these if needed

    // {
    //   "label": "Arduino: Clean Build",
    //   "command": "rm -rf build compile_commands.json *.elf *.hex *.bin && echo 'Build artifacts cleaned'",
    //   "use_new_terminal": false
    // },
    // {
    //   "label": "Arduino: Format Code",
    //   "command": "if command -v clang-format >/dev/null 2>&1; then find . -maxdepth 1 -name '*.ino' -exec clang-format -i {} \\; && echo 'Code formatted'; else echo 'Error: clang-format not found'; exit 1; fi",
    //   "use_new_terminal": true
    // }
  ]
}
